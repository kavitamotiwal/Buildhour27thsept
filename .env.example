# Copy to .env and fill in real values. .env is gitignored; never commit real keys.

# --- Embedding backend --------------------------------------------------------
# auto  = hosted when EMBEDDING_API_KEY is set, otherwise local
# local = offline ONNX model (fastembed), no key needed
# hosted= OpenAI-compatible /embeddings endpoint
# Changing this changes the score distribution: re-run scripts/calibrate_threshold.py.
EMBEDDING_BACKEND=auto

# --- Required when EMBEDDING_BACKEND resolves to hosted (Phase 2/3) ------------
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Leave blank to use the backend default: hosted -> text-embedding-3-small,
# local -> BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=

# --- Required from Phase 4 (generation) ---------------------------------------
# auto  = hosted when LLM_API_KEY is set, otherwise local
# local = offline fallback, NOT implemented yet
# hosted= any OpenAI-compatible /chat/completions endpoint
LLM_BACKEND=auto

# The key. Leave blank for no LLM: the app refuses cleanly and names the missing var.
LLM_API_KEY=

# BLANK means OpenAI. Every other provider MUST set it, or your key is sent to
# OpenAI and comes back as a 401.
#   OpenAI      (blank)
#   Groq        https://api.groq.com/openai/v1      -> llama-3.1-8b-instant
#   OpenRouter  https://openrouter.ai/api/v1        -> openai/gpt-4o-mini
#   Ollama      http://localhost:11434/v1           -> llama3.2
LLM_BASE_URL=

# Exactly as the provider spells it.
LLM_MODEL=gpt-4o-mini

# --- Tunables (architecture.md section 3.10) ---------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4

# The refusal gate. Calibrated by scripts/calibrate_threshold.py against this corpus with
# BAAI/bge-small-en-v1.5: in-corpus scores [0.7478, 0.8346], out-of-corpus [0.4418, 0.5999].
# 0.6739 is the midpoint, a margin of 0.074 on both sides.
#
# This is ALSO the built-in application default (DEFAULT_SIMILARITY_THRESHOLD in
# ragchat/config.py), so you can delete this line entirely and the gate still works: a missing
# value falls back to 0.6739 rather than leaving the gate open. It is set out explicitly here
# because a config you can read beats one you have to go and look up, and because a fresh
# clone that skips this file must still refuse out-of-corpus questions.
#
# Re-derive after changing EMBEDDING_MODEL, CHUNK_SIZE, CHUNK_OVERLAP, or the corpus.
SIMILARITY_THRESHOLD=0.6739

LLM_TEMPERATURE=0.2

# Turns replayed to the MODEL when it reads the question (generation).
HISTORY_TURNS=3

# Turns replayed to the EMBEDDER when it builds the retrieval query. Wider than
# HISTORY_TURNS on purpose: the embedding needs the older referent, the model does
# not. Only used for questions that actually refer back, so unrelated ones stay
# stateless. Raise it and stale topics start diluting the query again.
RETRIEVAL_HISTORY_TURNS=10

EMBED_BATCH_SIZE=32
LLM_TIMEOUT_S=30

# --- Paths --------------------------------------------------------------------
DOCS_DIR=documents
CHROMA_DIR=data/chroma
